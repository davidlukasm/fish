   },
   "cooldown": 20,
   "stations": [
    "{surpriseStation}"
   ],
   "icon": {
    "lex": "icon.surprise"
   },
   "brief": {
    "lex": "brief.surprise"
   }
  },
  {
   "topic": "poke",
   "when": "poked > 0 && dice < 0.4",
   "salience": "1.2",
   "texts": {
    "cases": [
     {
      "when": "pokedOrgan > 0",
      "lex": "poke.organ"
     },
     {
      "lex": "poke.hub"
     }
    ]
   },
   "cooldown": 30,
   "stations": [
    "{pokeStation}"
   ],
   "vars": {
    "acc": {
     "lex": "accusative.{pokeStation}"
    }
   },
   "icon": {
    "lex": "icon.poke"
   },
   "brief": {
    "lex": "brief.poke"
   }
  },
  {
   "topic": "probe",
   "when": "probe > probe_prev",
   "salience": "1.4",
   "texts": {
    "cases": [
     {
      "when": "probeKind == 0",
      "lex": "probe.light"
     },
     {
      "when": "probeKind == 1",
      "lex": "probe.scent"
     },
     {
      "lex": "probe.body"
     }
    ]
   },
   "cooldown": 20,
   "vars": {
    "colour": {
     "lex": "colour.{probeColour}"
    },
    "x": {
     "lex": "scent.{probeScent}"
    }
   },
   "icon": {
    "lex": "icon.probe"
   },
   "brief": {
    "cases": [
     {
      "when": "probeKind == 0",
      "lex": "brief.probe.light"
     },
     {
      "when": "probeKind == 1",
      "lex": "brief.probe.scent"
     },
     {
      "lex": "brief.probe.body"
     }
    ]
   }
  },
  {
   "topic": "idle",
   "when": "quiet > 12",
   "salience": "0.31",
   "texts": {
    "lex": [
     "idle.any",
     "idle.{mood}"
    ]
   },
   "cooldown": 0,
   "vars": {
    "wish": {
     "lex": "wish"
    },
    "musing": {
     "lex": "musing"
    }
   },
   "icon": {
    "lex": "icon.idle"
   },
   "brief": {
    "lex": "brief.idle"
   }
  },
  {
   "topic": "buried",
   "when": "buried > 0.5 && buried_prev <= 0.5",
   "salience": "1.3",
   "texts": {
