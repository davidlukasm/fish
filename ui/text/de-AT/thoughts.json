   "texts": {
    "lex": "fight"
   },
   "cooldown": 8,
   "stations": [
    "bite"
   ],
   "icon": {
    "lex": "icon.fight"
   },
   "brief": {
    "lex": "brief.fight"
   }
  },
  {
   "topic": "defense",
   "when": "defense > 0.3 && defense > defense_prev",
