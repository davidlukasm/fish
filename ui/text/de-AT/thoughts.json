 "rules": [
  {
   "topic": "sight",
   "when": "hasEyes && eyeNews > 0",
   "salience": "clamp(eyeNews)",
   "texts": {
    "lex": "sight"
   },
   "cooldown": 6,
   "stations": [
    "{eyeStation}"
   ],
   "vars": {
    "side": {
     "lex": "side.{eyeSide}"
    },
    "light": {
     "lex": "tone.{eyeTone}.light"
    },
    "verb": {
     "lex": "tone.{eyeTone}.verb"
    },
    "noun": {
     "lex": "tone.{eyeTone}.noun"
    },
    "thing": {
     "lex": "tone.{eyeTone}.thing"
    }
   },
   "icon": {
    "lex": "icon.sight"
   },
   "brief": {
    "lex": "brief.sight"
   }
  },
  {
   "topic": "lateral",
   "when": "hasLateral && latNews > 0",
   "salience": "clamp(latNews)",
   "texts": {
    "lex": "lateral"
   },
   "cooldown": 8,
   "stations": [
    "{latStation}"
   ],
   "vars": {
    "side": {
     "lex": "side.{latSide}"
    },
    "from": {
     "lex": "from.{latSide}"
    }
   },
   "icon": {
    "lex": "icon.lateral"
   },
   "brief": {
    "lex": "brief.lateral"
   }
  },
  {
   "topic": "touch",
   "when": "contact_rise > 0.05 || touch_rise > 0.08",
   "salience": "clamp(max(contact_rise * 3, touch_rise * 6))",
   "texts": {
    "lex": "touch"
   },
   "cooldown": 8,
   "stations": [
    "touch"
   ],
   "icon": {
    "lex": "icon.touch"
   },
   "brief": {
    "lex": "brief.touch"
   }
  },
  {
   "topic": "smell",
   "when": "hasNose && scentIndex >= 0",
   "salience": "scentNews",
   "texts": {
    "lex": "smell"
   },
   "cooldown": 14,
   "stations": [
    "{noseStation}"
   ],
   "vars": {
    "x": {
     "lex": "scent.{scentIndex}"
    },
    "side": {
     "lex": "side.{scentSide}"
    },
    "strength": {
     "lex": "strength.{scentBand}"
    },
    "follow": {
     "cases": [
      {
       "when": "scentIndex <= 4 && hunger > 0.5",
       "lex": "follow.hungry"
      },
      {
       "when": "scentIndex <= 4",
       "lex": "follow.sated"
      },
      {
       "when": "scentIndex == 5 && hunger > 0.6",
       "lex": "follow.carrionHungry"
      },
      {
       "when": "scentIndex == 5",
       "lex": "follow.carrion"
      },
      {
       "when": "scentIndex == 6",
       "lex": "follow.eggs"
      },
      {
       "when": "eggReady > 0.8",
       "lex": "follow.mateReady"
      },
      {
       "lex": "follow.mate"
      }
     ]
    }
   },
   "icon": {
    "lex": "icon.smell"
   },
   "brief": {
    "lex": "brief.smell"
   }
  },
  {
   "topic": "intent:{intentKey}",
   "when": "intentNews > 0.25",
   "salience": "clamp(intentNews * 1.4)",
   "texts": {
    "lex": "intent.{intentKey}.{intentSign}",
    "else": "intent.{intentOrgan}.{intentSign}"
   },
   "cooldown": 30,
   "stations": [
    "{intentStation}"
   ],
   "icon": {
    "lex": "icon.{intentSign}"
   },
   "brief": {
    "lex": "brief.intent.{intentSign}"
   }
  },
  {
   "topic": "hunger",
   "when": "hunger > 0.55",
   "salience": "(hunger - 0.5) * 1.2",
   "texts": {
    "lex": "hunger"
   },
   "cooldown": 30,
   "stations": [
    "gut"
   ],
   "vars": {
    "feast": {
     "lex": "feast"
    },
    "craving": {
     "lex": "craving"
    }
   },
   "icon": {
    "lex": "icon.hunger"
   },
   "brief": {
    "lex": "brief.hunger"
   }
  },
  {
   "topic": "eat",
   "when": "eating > 0.05 && eating > eating_prev",
   "salience": "0.9",
   "texts": {
    "lex": "eat"
   },
   "cooldown": 5,
   "stations": [
    "{mouthStation}"
   ],
   "vars": {
    "how": {
     "lex": "suckHow"
    },
    "mouthful": {
     "cases": [
      {
       "when": "pumping > 0",
       "lex": "suck"
      },
      {
       "lex": "bite"
      }
     ]
    },
    "food": {
     "lex": "scent.{scentIndex}"
    },
    "taste": {
     "cases": [
      {
       "when": "scentIndex >= 0 && scentIndex <= 4",
       "lex": "taste"
      },
      {
       "lex": "tasteUnknown"
      }
     ]
    }
   },
   "icon": {
    "lex": "icon.eat"
   },
   "brief": {
    "lex": "brief.eat"
   }
  },
  {
   "topic": "full",
   "when": "fullness > 0.7 && fullness > fullness_prev + 0.02",
   "salience": "0.6",
   "texts": {
    "lex": "full"
   },
   "cooldown": 40,
   "stations": [
    "gut"
   ],
   "icon": {
    "lex": "icon.full"
   },
   "brief": {
    "lex": "brief.full"
   }
  },
  {
   "topic": "pain",
   "when": "pain > 0.03 && pain > pain_prev + 0.01",
   "salience": "1.5 + pain",
   "texts": {
    "lex": "pain"
   },
   "cooldown": 3,
   "stations": [
    "gut"
   ],
   "icon": {
    "lex": "icon.pain"
   },
   "brief": {
    "lex": "brief.pain"
   }
  },
  {
   "topic": "health",
   "when": "health < 0.5",
   "salience": "0.6 - health",
   "texts": {
    "lex": "health"
   },
   "cooldown": 60,
   "stations": [
    "gut"
   ],
   "icon": {
    "lex": "icon.health"
   },
   "brief": {
    "lex": "brief.health"
   }
  },
  {
   "topic": "move",
   "when": "thrust_rise > 0.02 && thrust_norm > 0.6",
   "salience": "clamp(thrust_rise * 8)",
   "texts": {
    "lex": "move"
   },
   "cooldown": 15,
   "stations": [
    "tail"
   ],
   "icon": {
    "lex": "icon.move"
   },
   "brief": {
    "lex": "brief.move"
   }
  },
  {
   "topic": "drift",
   "when": "thrust_norm < 0.15 && thrust_prevNorm > 0.3",
   "salience": "0.4",
   "texts": {
    "lex": "drift"
   },
   "cooldown": 20,
   "stations": [
    "tail"
   ],
   "icon": {
    "lex": "icon.drift"
   },
   "brief": {
    "lex": "brief.drift"
   }
  },
  {
   "topic": "turn",
   "when": "turn_rise > 0.05 && turn_norm > 0.6",
   "salience": "clamp(turn_rise * 5)",
   "texts": {
    "lex": "turn"
   },
   "cooldown": 12,
   "stations": [
    "{turnStation}"
   ],
   "icon": {
    "lex": "icon.turn"
   },
   "brief": {
    "lex": "brief.turn"
   }
  },
  {
   "topic": "ready",
   "when": "ready > 0.8",
   "salience": "(ready - 0.7) * 1.2",
   "texts": {
    "cases": [
     {
      "when": "eggReady >= spermReady",
      "lex": "ready.eggs"
     },
     {
      "lex": "ready.sperm"
     }
    ]
   },
   "cooldown": 60,
   "stations": [
    "{gonadStation}"
   ],
   "icon": {
    "lex": "icon.ready"
   },
   "brief": {
    "lex": "brief.ready"
   }
  },
  {
   "topic": "eggs",
   "when": "eggLaying > eggLaying_prev",
   "salience": "2",
   "texts": {
    "lex": "laying.eggs"
   },
   "cooldown": 5,
   "stations": [
    "egg"
   ],
   "icon": {
    "lex": "icon.eggs"
   },
   "brief": {
    "lex": "brief.eggs"
   }
  },
  {
   "topic": "sperm",
   "when": "spermLaying > spermLaying_prev",
   "salience": "2",
   "texts": {
    "lex": "laying.sperm"
   },
   "cooldown": 5,
   "stations": [
    "sperm"
   ],
   "icon": {
    "lex": "icon.sperm"
   },
   "brief": {
    "lex": "brief.sperm"
   }
  },
  {
   "topic": "fight",
   "when": "aggression > 0.3 && aggression > aggression_prev",
