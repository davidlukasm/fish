   "texts": {
    "lex": [
     "learned.{lessonKey}",
     "learned.any"
    ]
   },
   "cooldown": 20,
   "icon": {
    "lex": "icon.learn"
   },
   "brief": {
    "lex": "brief.learn"
   }
  },
  {
   "topic": "surprise",
   "when": "surpriseNews > 0",
   "salience": "clamp(surpriseNews)",
