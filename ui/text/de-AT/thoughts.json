    "lex": "defense"
   },
   "cooldown": 8,
   "stations": [
    "spines"
   ],
   "icon": {
    "lex": "icon.defense"
   },
   "brief": {
    "lex": "brief.defense"
   }
  },
  {
   "topic": "bladder",
   "when": "hasBladder && abs(bladder_rise) > 0.03",
   "salience": "clamp(abs(bladder_rise) * 8)",
   "texts": {
    "cases": [
     {
      "when": "bladder_rise > 0",
      "lex": "bladder.up"
     },
     {
      "lex": "bladder.down"
     }
    ]
   },
   "cooldown": 20,
   "stations": [
    "bladder"
   ],
   "icon": {
    "lex": "icon.bladder"
   },
   "brief": {
    "cases": [
     {
      "when": "bladder_rise > 0",
      "lex": "brief.bladder.up"
     },
     {
      "lex": "brief.bladder.down"
     }
    ]
   }
  },
  {
   "topic": "pigment",
   "when": "hasPigment && pigment_rise > 0.08",
   "salience": "clamp(pigment_rise * 4)",
   "texts": {
    "lex": "pigment"
   },
   "cooldown": 25,
   "stations": [
    "pigment"
   ],
   "icon": {
    "lex": "icon.pigment"
   },
   "brief": {
    "lex": "brief.pigment"
